{
  "name": "finishes-app-server",
  "productName": "شطب",
  "version": "1.0.1",
  "description": "شطب",
  "main": "main.bundle.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "nodemon app.js",
    "electron": "electron-forge start",
    "winpackage": "electron-packager . شطب --platform=win32 --arch=x64 --overwrite --app-version=1.0.0 --build-version=1.0.0 --win32metadata.ProductName=شطب --FileDescription=شطب --appname=شطب --win32metadata.CompanyName=ng --app-copyright=ng --icon=dist/home.png",
    "package": "electron-forge package",
    "make": "electron-forge make --platform=win32 --arch=x64",
    "publish": "electron-forge publish",
    "pkg": "electron-packager . شطب --platform=win32 --arch=x64",
    "bundle-main": "esbuild main.js --bundle --platform=node --external:electron --define:process.env.NODE_ENV=\\\"production\\\" --outfile=main.bundle.js",
    "build-installer": "npm run bundle-main && electron-builder --win"
  },
  "build": {
    "appId": "finishes_app",
    "productName": "شطب",
    "asar": false,
    "npmRebuild": false,
    "artifactName": "Shatab-Setup-${version}.${ext}",
    "files": [
      "main.bundle.js",
      "dist/**/*",
      "routes/**/*",
      "models/**/*",
      "controllers/**/*",
      "main.js",
      "app.js",
      "favicon.ico",
      "home.png",
      "preload.js",
      "package.json"
    ],
    "directories": {
      "output": "win32/installer",
      "buildResources": "dist"
    },
    "extraFiles": [
      {
        "from": "uploads",
        "to": "uploads",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "favicon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "uninstallDisplayName": "شطب - إدارة الحسابات والتشطيبات",
      "shortcutName": "شطب",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "config": {
    "forge": {
      "electronPackagerConfig": {
        "icon": "favicon.ico"
      },
      "packagerConfig": {
        "icon": "favicon.ico"
      },
      "publishers": [
        {
          "name": "@electron-forge/publisher-s3",
          "platforms": [
            "darwin",
            "linux",
            "win"
          ],
          "config": {
            "bucket": "my-bucket",
            "folder": "my/key/prefix"
          }
        },
        {
          "name": "@electron-forge/publisher-github",
          "config": {
            "repository": {
              "owner": "Ahmed21kh",
              "name": "electron"
            },
            "prerelease": false,
            "draft": true
          }
        }
      ],
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "electron_quick_start",
            "options": {
              "icon": "favicon.ico"
            }
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "config": {
            "name": "electron_quick_start",
            "options": {
              "icon": "favicon.ico"
            }
          },
          "platforms": [
            "darwin",
            "win"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {
            "options": {
              "icon": "favicon.ico"
            }
          }
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ]
    }
  },
  "keywords": [],
  "author": "Ahmed Khaled",
  "license": "ISC",
  "dependencies": {
    "@electron-forge/maker-rpm": "^7.7.0",
    "@electron-forge/maker-wix": "^7.7.0",
    "body-parser": "^1.20.2",
    "connect": "^3.7.0",
    "connect-livereload": "^0.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-reload": "^2.0.0-alpha.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-wix-msi": "^5.1.3",
    "express": "^4.21.2",
    "livereload": "^0.9.3",
    "lodash": "^4.17.21",
    "mongodb": "^6.6.2",
    "mongoose": "^8.3.5",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.1.1",
    "path": "^0.12.7",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.7.0",
    "@electron-forge/maker-deb": "^7.7.0",
    "@electron-forge/maker-squirrel": "^7.7.0",
    "@electron-forge/maker-zip": "^7.7.0",
    "@electron-forge/publisher-github": "^7.7.0",
    "@electron-forge/publisher-s3": "^7.7.0",
    "electron": "^35.0.2",
    "electron-builder": "^25.1.8",
    "electron-reloader": "^1.2.3",
    "esbuild": "^0.25.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  }
}
